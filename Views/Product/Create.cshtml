@model homework.ViewModel.CreateProductViewModel

@{
    ViewData["Title"] = "Add Product";
}

<h1>Add New Product</h1>

<form asp-controller="Product"
      asp-action="Create"
      method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">
            Product Name
        </label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">
            Description
        </label>
        <textarea asp-for="Description"
                  class="form-control"></textarea>
        <span asp-validation-for="Description"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label">
            Price
        </label>
        <input asp-for="Price"
               type="number"
            
               class="form-control" />
        <span asp-validation-for="Price"
              class="text-danger"></span>
    </div>

 
<div class="mb-3">
    <label asp-for="CategoryId" class="form-label">
        Category ID
    </label>
    <input asp-for="CategoryId"
           type="number"
           min="1"
           class="form-control" />
    <span asp-validation-for="CategoryId"
          class="text-danger"></span>
</div>

    <div class="mb-3">
        <label asp-for="ImageUrl" class="form-label">
            Image URL
        </label>
        <input asp-for="ImageUrl" class="form-control" />
        <span asp-validation-for="ImageUrl"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Save Product
    </button>

    <a asp-controller="Product"
       asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>
</form>
