@model homework.ViewModel.CreateCategoryViewModel

<h1>Add New Category!</h1>
<hr />

<form asp-controller="Category" asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label">Category Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>
    </div>

    <input type="submit" class="btn btn-primary" value="Save" />

    <a asp-controller="Category" asp-action="Index"
       class="btn btn-danger">Back</a>
</form>